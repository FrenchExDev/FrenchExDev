#requires -Version 7.4
#requires -PSEdition Core
# Generated by copying the DevPoSh resource. Re-run Set-DevPoShPowershellProfile to update.
$OutputEncoding=[Text.UTF8Encoding]::new($false)
try{[Console]::InputEncoding=$OutputEncoding;[Console]::OutputEncoding=$OutputEncoding}catch{}
if($env:TERM_PROGRAM -eq 'vscode' -and (Get-Command code -CommandType Application -ErrorAction SilentlyContinue)) {
    try{
        $integration=& code --locate-shell-integration-path pwsh
        if($LASTEXITCODE -eq 0 -and $integration -is [string] -and (Test-Path -LiteralPath $integration -PathType Leaf)){. $integration}
    }catch{Write-Verbose 'VS Code shell integration unavailable.'}
}
$MyPoShClonePath=$env:FRENCHEXDEV_MYDEVPOSH_PATH
if([string]::IsNullOrWhiteSpace($MyPoShClonePath) -or !(Test-Path -LiteralPath $MyPoShClonePath -PathType Container)) {
    Write-Warning 'DevPoSh: set FRENCHEXDEV_MYDEVPOSH_PATH to the PoSh directory; module loading skipped.'
} elseif($env:FRENCHEXDEV_DEVPOSH -eq 'Production') {
    $startupPath=Join-Path $HOME '.posh.posh.compilations/startup.json'
    if(!(Test-Path -LiteralPath $startupPath -PathType Leaf)) {
        Write-Warning 'DevPoSh: compilation inventory missing. Import DevPoSh from sources and run Get-DevPoSh -Action CompileAll.'
    } else {
        try {
            $startup=ConvertFrom-Json -InputObject ([IO.File]::ReadAllText($startupPath)) -ErrorAction Stop
            if($startup.Version -ne 1){throw 'Unsupported startup inventory.'}
            $loaded=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
            foreach($entry in $startup.Modules) {
                if($entry.SourceRoot -ne [IO.Path]::GetFullPath($MyPoShClonePath)){continue}
                if(!$loaded.Add($entry.Path)){continue}
                try{
                    if(!(Test-Path -LiteralPath $entry.Path -PathType Leaf)){throw 'Missing artifact.'}
                    Import-Module -Name $entry.Path -Global -DisableNameChecking -ErrorAction Stop
                }catch{Write-Warning 'DevPoSh: an artifact could not load. Rebuild explicitly with Get-DevPoSh -Action CompileAll.'}
            }
        }catch{Write-Warning 'DevPoSh: invalid compilation inventory; rebuild explicitly.'}
    }
} else {
    $devManifest=Join-Path $MyPoShClonePath 'FrenchExDev/FrenchExDev.DevPoSh.PoSh/DevPoSh.PoSh.psd1'
    try {
        Import-Module -Name $devManifest -Global -DisableNameChecking -ErrorAction Stop
        Import-DevPoShModule -Path $MyPoShClonePath
    }catch{Write-Warning 'DevPoSh: development loader unavailable; check the configured source directory.'}
}
if(Get-Command Setup-OutputPumps -CommandType Function -ErrorAction SilentlyContinue) {
    try {
        $pumpSetup=Setup-OutputPumps
        if($pumpSetup.Outcome -ne 'Success'){Write-Warning 'OutputPumps: setup failed; check ~/.pumps-config.yaml and run Setup-OutputPumps.'}
    }catch{Write-Warning 'OutputPumps: setup unavailable; other profile features remain active.'}
}
