{  "builders": [    {      "boot_command": [        "root<enter><wait>",        "ifconfig eth0 up && udhcpc -i eth0<enter><wait5>",        "wget -O $PWD/answers http://{{ .HTTPIP }}:{{ .HTTPPort }}/answers<enter><wait>",        "export USEROPTS='-a -u -g audio,video,netdev {{user `ssh_username`}}'<enter>",        "export USERSSHKEY='http://{{ .HTTPIP }}:{{ .HTTPPort }}/ssh.keys'<enter>",        "setup-alpine -f $PWD/answers<enter><wait5>",        "{{user `root_password`}}<enter><wait>",        "{{user `root_password`}}<enter><wait10>",        "mount /dev/sda3 /mnt<enter>",        "echo 'PermitRootLogin yes' >> /mnt/etc/ssh/sshd_config<enter>",        "umount /mnt; reboot<enter>"      ],      "boot_wait": "10s",      "communicator": "ssh",      "disk_size": "{{ user `disk_size` }}",      "format": "ova",      "headless": false,      "http_directory": "http",      "iso_checksum": "{{user `iso_checksum_type`}}:{{user `iso_checksum`}}",      "iso_urls": [        "{{user `iso_local_url`}}",        "{{user `iso_download_url`}}"      ],      "keep_registered": "true",      "shutdown_command": "/sbin/poweroff",      "ssh_password": "{{user `root_password` }}",      "ssh_timeout": "10m",      "ssh_username": "root",      "type": "virtualbox-iso",      "guest_os_type": "Linux_64",      "guest_additions_url": "https://download.virtualbox.org/virtualbox/{{user `vbox_version`}}/VBoxGuestAdditions_{{user `vbox_version`}}.iso",      "guest_additions_sha256": "{{user `vbox_guest_additions_iso_sha256`}}",      "guest_additions_path": "VBoxGuestAdditions.iso",      "guest_additions_mode": "upload",      "virtualbox_version_file": "VBoxVersion.txt",      "vboxmanage": [        [          "modifyvm",          "{{ .Name }}",          "--memory",          "{{user `memory`}}"        ],        [          "modifyvm",          "{{ .Name }}",          "--cpus",          "{{user `cpus`}}"        ],        [          "modifyvm",          "{{ .Name }}",          "--nat-localhostreachable1",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--vram",          "{{user `vmemory`}}"        ],        [          "modifyvm",          "{{ .Name }}",          "--natdnshostresolver1",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--ioapic",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--hwvirtex",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--hpet",          "off"        ],        [          "modifyvm",          "{{ .Name }}",          "--largepages",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--vtxvpid",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--vtxux",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--pae",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--acpi",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--pagefusion",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--chipset",          "ich9"        ],        [          "modifyvm",          "{{ .Name }}",          "--vrde",          "off"        ],        [          "modifyvm",          "{{ .Name }}",          "--usb",          "off"        ],        [          "modifyvm",          "{{ .Name }}",          "--nested-hw-virt",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--nestedpaging",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--ostype",          "Linux_x64"        ],        [          "modifyvm",          "{{ .Name }}",          "--graphicscontroller",          "vmsvga"        ],        [          "setproperty",          "hwvirtexclusive",          "on"        ],        [          "modifyvm",          "{{ .Name }}",          "--paravirtprovider",          "kvm"        ],        [          "storagectl",          "{{ .Name }}",          "--name=SATA Controller",          "--hostiocache",          "off"        ],        [          "storageattach",          "{{ .Name }}",          "--storagectl=SATA Controller",          "--port=0",          "--nonrotational",          "on"        ],        [          "storageattach",          "{{ .Name }}",          "--storagectl=SATA Controller",          "--port=0",          "--discard",          "on"        ],        [          "setextradata",          "{{ .Name }}",          "VBoxInternal/Devices/ahci/0/Config/Port0/NonRotational",          "1"        ]      ],      "hard_drive_interface": "sata",      "hard_drive_discard": true,      "vm_name": "{{user `vm_name`}}"    }  ],  "description": "Build Base Alpine Linux x86_64",  "provisioners": [    {      "type": "shell",      "scripts": [        "scripts/00base.sh",        "scripts/01alpine.sh",        "scripts/01networking.sh",        "scripts/02sshd.sh",        "scripts/03vagrant.sh",        "scripts/04sudoers.sh",        "scripts/05cron.sh",        "scripts/99reboot.sh"      ],      "override": {        "virtualbox-iso": {          "execute_command": "{{.Vars}} /bin/sh {{.Path}}"        }      },      "pause_before": null    },    {      "type": "shell",      "scripts": [        "scripts/99minimize.sh",        "scripts/99disable-ssh-root.sh"      ],      "override": {        "virtualbox-iso": {          "execute_command": "{{.Vars}} /bin/sh {{.Path}}"        }      },      "pause_before": "20s"    }  ],  "post-processors": [    {      "type": "vagrant",      "compression_level": 9,      "keep_input_artifact": true,      "output": "{{user `output_vagrant` }}/{{user `vm_name`}}{{user `flavor`}}.box",      "vagrantfile_template": "./vagrant/Vagrantfile"    }  ],  "variables": {    "output_vagrant": "output-vagrant",    "box-version": "1.0.0",    "vbox_version": "7.1.6",    "vbox_guest_additions_iso_sha256": "dbbda1645bc05c9260adfe9efc4949cb590ec5ec02680aff936375670cffcafc",    "community_repo": "http://dl-cdn.alpinelinux.org/alpine/v3.20/community",    "cpus": "4",    "disk_size": "20480",    "iso_checksum": "27cbb137dbf90c74856fb44f90488066c8bb7aee979365255c63ef925e1de521",    "iso_checksum_type": "sha256",    "iso_download_url": "https://dl-cdn.alpinelinux.org/alpine/v3.20/releases/x86_64/alpine-virt-3.20.0-x86_64.iso",    "iso_local_url": "./cache/iso/alpine-virt-3.20.0-x86_64.iso",    "memory": "256",    "root_password": "vagrant",    "ssh_password": "vagrant",    "ssh_username": "vagrant",    "vmemory": "64",    "vm_name": "alpine-3.20.0-x86_64-17-04-2025_06-30"  }}