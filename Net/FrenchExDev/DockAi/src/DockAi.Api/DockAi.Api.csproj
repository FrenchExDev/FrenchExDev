<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DockAi.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Search engine -->
    <PackageReference Include="Lucene.Net" />
    <PackageReference Include="Lucene.Net.Analysis.Common" />
    <PackageReference Include="Lucene.Net.Facet" />
    <PackageReference Include="Lucene.Net.QueryParser" />
    <PackageReference Include="Lucene.Net.Suggest" />
    <PackageReference Include="Lucene.Net.Highlighter" />
    <!-- Document parsers -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>
