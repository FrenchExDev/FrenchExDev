# ═══════════════════════════════════════════
# DockAi Ontology — Erard vs Qwant
# ═══════════════════════════════════════════

# ─── ENTITY TYPES ─────────────────────────

@type person {
    name: string
    role: enum [plaignant, defenderesse, temoin, complice, dirigeant, journaliste, avocat, politique]
    aliases: string[]
}

@type organization {
    name: string
    role: enum [defenderesse, societe_acquise, partenaire]
    aliases: string[]
}

@type institution {
    name: string
    role: enum [autorite, investisseur, regulateur]
    aliases: string[]
}

@type technology {
    name: string
    role: enum [moteur_source, outil, plateforme]
    aliases: string[]
}

@type legal_reference {
    code: string
    article: string
    description: string
}

@type monetary_amount {
    value: number
    currency: string
    context: string
}

@type date_event {
    date: date
    label: string
    significance: string
}

# ─── ENTITY INSTANCES ─────────────────────

@entity erard : person {
    name: "Stephane Erard"
    role: plaignant
    aliases: ["erard", "serard", "stephane", "s. erard", "stephane erard"]
}

@entity leandri : person {
    name: "Eric Leandri"
    role: dirigeant
    aliases: ["leandri", "eric leandri", "e. leandri"]
}

@entity vignaux : person {
    name: "Pierre Vignaux"
    role: complice
    aliases: ["vignaux", "pierre vignaux", "p. vignaux"]
}

@entity poinat : person {
    name: "Me Poinat"
    role: avocat
    aliases: ["poinat", "me poinat", "maitre poinat", "avocate poinat"]
}

@entity bourrelly : person {
    name: "Bourrelly"
    role: complice
    aliases: ["bourrelly"]
}

@entity decaux : person {
    name: "Thomas Decaux"
    role: complice
    aliases: ["decaux", "thomas decaux", "t. decaux"]
}

@entity mathieu : person {
    name: "Eric Mathieu"
    role: temoin
    aliases: ["mathieu", "eric mathieu"]
}

@entity champeau : person {
    name: "Guillaume Champeau"
    role: journaliste
    aliases: ["champeau", "guillaume champeau", "gchampeau"]
}

@entity cassar : person {
    name: "Jonathan Cassar"
    role: temoin
    aliases: ["cassar", "jonathan cassar"]
}

@entity qwant : organization {
    name: "Qwant SAS"
    role: defenderesse
    aliases: ["qwant", "qwant sas"]
}

@entity xilopix : organization {
    name: "Xilopix/Xaphir"
    role: societe_acquise
    aliases: ["xilopix", "xaphir"]
}

@entity cnil : institution {
    name: "CNIL"
    role: autorite
    aliases: ["cnil", "commission nationale informatique"]
}

@entity bpi : institution {
    name: "BPI/CDC"
    role: investisseur
    aliases: ["bpi", "cdc", "caisse des depots", "bpifrance", "bpi france"]
}

@entity dinum : institution {
    name: "DINUM"
    role: regulateur
    aliases: ["dinum"]
}

@entity bing : technology {
    name: "Microsoft Bing"
    role: moteur_source
    aliases: ["bing", "microsoft bing"]
}

@entity sonarqube : technology {
    name: "SonarQube"
    role: outil
    aliases: ["sonarqube", "sonar"]
}

# ─── RELATION TYPES ───────────────────────

@relation.type employs {
    from: organization
    to: person
    properties: [start_date, end_date, position]
    inverse: employed_by
}

@relation.type accuses {
    from: person
    to: [person, organization]
    properties: [motif, date, gravite]
    inverse: accused_by
}

@relation.type directs {
    from: person
    to: organization
    properties: [start_date, end_date, titre]
    inverse: directed_by
}

@relation.type represents {
    from: person
    to: person
    properties: [type_mandat, date_debut]
    inverse: represented_by
}

@relation.type invests_in {
    from: institution
    to: organization
    properties: [montant, date, type_investissement]
    inverse: funded_by
}

@relation.type acquired {
    from: organization
    to: organization
    properties: [date, montant, conditions]
    inverse: acquired_by
}

@relation.type uses {
    from: organization
    to: technology
    properties: [date_debut, contexte]
}

@relation.type regulates {
    from: institution
    to: [person, organization]
    properties: [type_procedure, numero_dossier]
    inverse: regulated_by
}

@relation.type audits {
    from: institution
    to: organization
    properties: [date, type_audit, conclusion]
    inverse: audited_by
}

@relation.type mentions {
    from: document
    to: [person, organization, institution, legal_reference]
    auto: true
    properties: [count, positions]
}

@relation.type shared_context {
    from: document
    to: document
    auto: true
    symmetric: true
    properties: [via_entities, via_themes, strength]
}

