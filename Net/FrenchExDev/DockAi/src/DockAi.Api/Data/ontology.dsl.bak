# ─── TAXONOMIES ───────────────────────────

@taxonomy track {
    label: "Piste juridique"
    facet: true

    voie_a "Voie penale" { color: "#E74C3C", desc: "Plaintes penales, escroquerie, fraude" }
    voie_b "Voie prudhomale" { color: "#3498DB", desc: "Licenciement, harcelement, Syntec 3.3" }
    voie_c "Voie avocate" { color: "#9B59B6", desc: "Responsabilite professionnelle Me Poinat" }
    cnil_rgpd "CNIL/RGPD" { color: "#F39C12", desc: "Protection des donnees" }
    media "Strategie media" { color: "#1ABC9C", desc: "Presse, tribunes" }
}

@taxonomy theme {
    label: "Theme"
    facet: true

    fraude "Fraude" {
        fraude_tech "Fraude technique" { desc: "Bing repackage, faux moteur, audit DINUM" }
        financier "Detournements financiers" { desc: "BPI/CDC, hauts salaires, escroquerie" }
    }
    droit_travail "Droit du travail" {
        emploi "Emploi" { desc: "Licenciement, Syntec 3.3, requalification" }
        harcelement "Harcelement" { desc: "Harcelement moral, pression, intimidation" }
    }
    lanceur_alerte "Lanceur d'alerte" { desc: "Protection, represailles, SLAPP" }
    rgpd "RGPD/Donnees" { desc: "Violations RGPD, saisine CNIL" }
    preuve "Preuves et forensique" { desc: "Git forensique, captures, attestations" }
    strategie "Strategie juridique" { desc: "Plans d'action, feuilles de route" }
    acteurs "Profils acteurs" { desc: "Fiches individuelles" }
    prescription "Prescription" { desc: "Delais, art. 2226" }
    responsabilite_avocat "Responsabilite avocate" { desc: "Fautes Poinat" }
}

@taxonomy category {
    label: "Categorie documentaire"
    facet: true

    juridique "Juridique" { color: "#C55A11" }
    technique "Technique" { color: "#002060" }
    financier_cat "Financier" { color: "#00B050" }
    preuve_cat "Preuves" { color: "#70AD47" }
    synthese "Synthese" { color: "#FF6B6B" }
    strategie_cat "Strategie" { color: "#1F4E79" }
    media_cat "Media" { color: "#FFC000" }
    acteurs_cat "Acteurs" { color: "#4ECDC4" }
    med_poinat "MED & Poinat" { color: "#7030A0" }
    medical "Medical" { color: "#A6A6A6" }
    personnel "Personnel" { color: "#E7E6E6" }
    archive "Archives" { color: "#595959" }
}

# ─── AUTO-CLASSIFICATION RULES ────────────

@rule auto_track_penal {
    when content matches "plainte|escroquerie|abus de confiance|penal|delit|infraction"
    then assign track: voie_a
    confidence: 0.7
}

@rule auto_track_prudhommes {
    when content matches "prud.hommes|licenciement|syntec|harcelement moral|code du travail"
    then assign track: voie_b
    confidence: 0.8
}

@rule auto_track_avocate {
    when content matches "responsabilit.+professionnelle|faute.+avocat|poinat|batonnier|manquement"
    then assign track: voie_c
    confidence: 0.7
}

@rule auto_track_cnil {
    when content matches "CNIL|RGPD|donn.es personnelles|protection des donn"
    then assign track: cnil_rgpd
    confidence: 0.8
}

@rule auto_theme_fraude_tech {
    when content matches "bing|repackag|faux moteur|DINUM|audit.+technique|sonarqube"
    then assign theme: fraude_tech
    confidence: 0.7
}

@rule auto_theme_financier {
    when content matches "BPI|CDC|caisse des dep|subvention|detournement|hauts salaires"
    then assign theme: financier
    confidence: 0.7
}

@rule auto_theme_lanceur {
    when content matches "lanceur.d.alerte|represailles|SLAPP|protection|divulgation"
    then assign theme: lanceur_alerte
    confidence: 0.8
}

@rule auto_theme_harcelement {
    when content matches "harcelement|intimidation|pression|burn.out|souffrance"
    then assign theme: harcelement
    confidence: 0.7
}

@rule auto_theme_rgpd {
    when content matches "RGPD|donn.es personnelles|traitement|consentement|CNIL"
    then assign theme: rgpd
    confidence: 0.7
}

@rule auto_theme_preuve {
    when content matches "git.+commit|forensique|capture|attestation|preuve|screenshot"
    then assign theme: preuve
    confidence: 0.6
}

@rule auto_theme_prescription {
    when content matches "prescription|art.+2226|d.lai|forclusion"
    then assign theme: prescription
    confidence: 0.8
}
