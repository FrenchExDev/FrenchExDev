<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!-- Include Lib source files directly (linked) — avoids analyzer assembly loading issues -->
  <ItemGroup>
    <Compile Include="..\FrenchExDev.Net.Builder.SourceGenerator.Lib\BuilderEmitter.cs" Link="Lib\BuilderEmitter.cs" />
    <Compile Include="..\FrenchExDev.Net.Builder.SourceGenerator.Lib\BuilderEmitModel.cs" Link="Lib\BuilderEmitModel.cs" />
  </ItemGroup>

</Project>
