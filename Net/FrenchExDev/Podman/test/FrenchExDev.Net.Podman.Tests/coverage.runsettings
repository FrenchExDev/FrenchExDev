<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Only measure the Podman library -->
          <Include>[FrenchExDev.Net.Podman]*</Include>
          <!-- Exclude compiler-generated and polyfill types -->
          <ExcludeByAttribute>System.CodeDom.Compiler.GeneratedCodeAttribute,System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- Exclude source-generated files (BinaryWrapper generator + regex generator) -->
          <ExcludeByFile>**/obj/Generated/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
